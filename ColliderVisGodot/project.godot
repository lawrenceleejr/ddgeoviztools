; ColliderVis — photoreal HEP collision-event visualizer (Godot 4.6, Forward+)
;
; Open this folder in Godot 4.6+ or run directly:
;   godot --path ColliderVisGodot
;
; Headless still render (no GPU required — Mesa lavapipe works):
;   xvfb-run godot --path ColliderVisGodot -- --screenshot=/tmp/out.png --frames=120
;
; Engine format generated by Godot 4.6.

config_version=5

[application]

config/name="ColliderVis"
config/description="Photo-realistic HEP detector & collision event visualizer"
config/version="1.0.0"
run/main_scene="res://scenes/splash.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.012, 0.016, 0.028, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
global_illumination/sdfgi/probe_ray_count=2
global_illumination/sdfgi/frames_to_converge=4
global_illumination/sdfgi/frames_to_update_lights=1
environment/ssao/quality=3
environment/ssil/quality=3
environment/screen_space_reflection/roughness_quality=3
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
environment/glow/upscale_mode=1
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=3
camera/depth_of_field/depth_of_field_use_jitter=true
textures/default_filters/anisotropic_filtering_level=4
